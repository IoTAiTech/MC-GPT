      "surface": "Gemini CLI"
    },
    {
      "id": "xai-grok-cli",
      "qualification": "planned",
      "surface": "Grok CLI"
    },
    {
      "id": "ollama-exact-model",
      "qualification": "planned",
      "surface": "Ollama local or cloud exact-model seat"
    }
  ],
  "research_questions": [
    "Does the structured Minimum Necessary Change Gate reduce change surface without reducing acceptance, security, privacy, accessibility, recovery, or test quality?",
    "Is the effect consistent across providers and task rungs?",
    "Does the gate reduce dependency, service, schema, agent, or abstraction growth?",
    "Does the gate reduce rework, tokens, cost, and wall-clock time after accounting for failed and timed-out runs?"
  ],
  "schema": "iot-ai.minimum-change-paired-benchmark-protocol.v1",
  "secondary_endpoints": [
    "files_added_modified_deleted",
    "tokens_input_output_reasoning",
    "provider_cost",
