{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-ai.tech/schemas/minimum-change-provider-assessment-v1.schema.json",
  "title": "MC-GPT Minimum Necessary Change Provider Assessment",
  "description": "Provider-visible structured assessment that is normalized and validated against the task-bound Minimum Necessary Change contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "selected_rung",
    "rung_assessments",
    "acceptance_criteria_preserved",
    "controls_preserved",
    "rejected_alternatives",
    "estimated_change_surface",
    "dependency_service_schema_agent_delta",
    "budget_exceptions",
    "verification_plan",
    "remaining_uncertainty"
  ],
  "properties": {
    "selected_rung": {
      "enum": [
        "necessity",
        "existing-capability",
        "standard-library",
        "native-platform",
        "existing-dependency",
        "minimal-local-change",
        "minimum-new-code"
      ]
    },
    "rung_assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "necessity",
        "existing-capability",
        "standard-library",
        "native-platform",
        "existing-dependency",
        "minimal-local-change",
        "minimum-new-code"
      ],
      "properties": {
        "necessity": {"$ref": "#/$defs/rungDecision"},
        "existing-capability": {"$ref": "#/$defs/rungDecision"},
        "standard-library": {"$ref": "#/$defs/rungDecision"},
        "native-platform": {"$ref": "#/$defs/rungDecision"},
        "existing-dependency": {"$ref": "#/$defs/rungDecision"},
        "minimal-local-change": {"$ref": "#/$defs/rungDecision"},
        "minimum-new-code": {"$ref": "#/$defs/rungDecision"}
      }
    },
    "acceptance_criteria_preserved": {"type": "boolean"},
    "controls_preserved": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {}
    },
    "estimated_change_surface": {
      "type": "object"
    },
    "dependency_service_schema_agent_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_dependencies",
        "new_external_services",
        "new_databases_or_schemas",
        "new_agents_or_provider_routes",
        "new_abstraction_layers"
      ],
      "properties": {
        "new_dependencies": {"$ref": "#/$defs/stringList"},
        "new_external_services": {"$ref": "#/$defs/stringList"},
        "new_databases_or_schemas": {"$ref": "#/$defs/stringList"},
        "new_agents_or_provider_routes": {"$ref": "#/$defs/stringList"},
        "new_abstraction_layers": {"$ref": "#/$defs/stringList"}
      }
    },
    "budget_exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_dependencies",
        "new_external_services",
        "new_databases_or_schemas",
        "new_agents_or_provider_routes",
        "new_abstraction_layers"
      ],
      "properties": {
        "new_dependencies": {"$ref": "#/$defs/budgetException"},
        "new_external_services": {"$ref": "#/$defs/budgetException"},
        "new_databases_or_schemas": {"$ref": "#/$defs/budgetException"},
        "new_agents_or_provider_routes": {"$ref": "#/$defs/budgetException"},
        "new_abstraction_layers": {"$ref": "#/$defs/budgetException"}
      }
    },
    "verification_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "remaining_uncertainty": {
      "type": "array",
      "items": {}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "rungDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "evidence_refs"],
      "properties": {
        "decision": {
          "enum": ["selected", "rejected", "not-applicable", "unassessed"]
        },
        "reason": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/stringList"}
      }
    },
    "budgetException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence_refs", "acceptance_refs"],
      "properties": {
        "reason": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/stringList"},
        "acceptance_refs": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
