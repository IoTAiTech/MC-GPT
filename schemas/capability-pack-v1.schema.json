{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-iot.tech/schemas/capability-pack-v1.schema.json",
  "title": "IOT-AI Capability Pack v1",
  "type": "object",
  "required": ["schema", "name", "version", "classification", "operations", "secrets_embedded"],
  "properties": {
    "schema": {"const": "iot-ai.capability-pack.v1"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "classification": {"enum": ["public", "unlisted", "private", "customer"]},
    "secrets_embedded": {"const": false},
    "materialize_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
