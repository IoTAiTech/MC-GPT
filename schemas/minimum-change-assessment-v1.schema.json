{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-ai.tech/schemas/minimum-change-assessment-v1.schema.json",
  "title": "MC-GPT Minimum Necessary Change Assessment",
  "description": "Evidence-bound pre-code assessment used to select the first sufficient solution rung without removing required safety, privacy, accessibility, data-protection or correctness controls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision",
    "selected_rung",
    "selected_strategy",
    "requirement_understanding",
    "evidence",
    "alternatives",
    "safety_invariants",
    "implementation_budget",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "iot-ai.minimum-change-assessment.v1"
    },
    "decision": {
      "enum": [
        "no-change",
        "reuse-existing",
        "use-standard-library",
        "use-native-capability",
        "use-existing-dependency",
        "minimal-local-change",
        "minimum-new-code"
      ]
    },
    "selected_rung": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "selected_strategy": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "requirement_understanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "affected_flow", "acceptance_criteria"],
      "properties": {
        "problem": {"type": "string", "minLength": 1},
        "affected_flow": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "finding"],
        "properties": {
          "kind": {
            "enum": [
              "repository-path",
              "symbol",
              "dependency",
              "standard-library",
              "native-platform",
              "database-capability",
              "runtime-evidence",
              "documentation",
              "not-applicable"
            ]
          },
          "reference": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rung", "strategy", "decision", "reason"],
        "properties": {
          "rung": {"type": "integer", "minimum": 1, "maximum": 7},
          "strategy": {"type": "string", "minLength": 1},
          "decision": {"enum": ["selected", "rejected", "not-applicable"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "safety_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_behavior",
        "trust_boundary_validation",
        "data_loss_prevention",
        "security_controls",
        "privacy_controls",
        "accessibility",
        "rollback_and_recovery",
        "deterministic_verification"
      ],
      "properties": {
        "requested_behavior": {"$ref": "#/$defs/invariant"},
        "trust_boundary_validation": {"$ref": "#/$defs/invariant"},
        "data_loss_prevention": {"$ref": "#/$defs/invariant"},
        "security_controls": {"$ref": "#/$defs/invariant"},
        "privacy_controls": {"$ref": "#/$defs/invariant"},
        "accessibility": {"$ref": "#/$defs/invariant"},
        "rollback_and_recovery": {"$ref": "#/$defs/invariant"},
        "deterministic_verification": {"$ref": "#/$defs/invariant"}
      }
    },
    "implementation_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_files_added",
        "max_files_modified",
        "max_added_lines",
        "max_new_runtime_dependencies",
        "required_tests"
      ],
      "properties": {
        "max_files_added": {"type": "integer", "minimum": 0, "maximum": 1000},
        "max_files_modified": {"type": "integer", "minimum": 0, "maximum": 1000},
        "max_added_lines": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "max_new_runtime_dependencies": {"type": "integer", "minimum": 0, "maximum": 100},
        "required_tests": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dissent": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["preserved", "strengthened", "not-applicable"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"selected_rung": {"minimum": 5}}},
      "then": {
        "properties": {
          "alternatives": {
            "contains": {
              "type": "object",
              "properties": {"rung": {"const": 1}, "decision": {"enum": ["rejected", "not-applicable"]}},
              "required": ["rung", "decision"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"selected_rung": {"const": 7}}},
      "then": {
        "properties": {
          "alternatives": {
            "minItems": 6
          }
        }
      }
    }
  ]
}
