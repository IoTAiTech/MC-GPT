{
  "analysis": {
    "bootstrap_confidence": 0.95,
    "bootstrap_iterations": 10000,
    "minimum_complete_pairs_per_comparison": 20,
    "multiple_comparison_note_required": true,
    "no_savings_claim_if_hard_gate_inferiority": true,
    "no_savings_claim_if_model_identity_unverified": true,
    "paired_by": [
      "task_id",
      "provider_id",
      "model_served",
      "repetition"
    ],
    "report_failures_separately": true,
    "report_median_and_iqr": true,
    "sign_test": true
  },
  "arms": [
    {
      "description": "MC-GPT workflow without an explicit minimum-change instruction or gate.",
      "enabled": true,
      "external_source": null,
      "id": "baseline"
    },
    {
      "description": "Same workflow plus one sentence requesting the simplest sufficient change.",
      "enabled": true,
      "external_source": null,
      "id": "simple-yagni"
    },
    {
      "description": "MC-GPT native structured Minimum Necessary Change Gate with evidence, budgets, and safety invariants.",
      "enabled": true,
      "external_source": null,
      "id": "mcgpt-minimum-change"
    },
    {
      "description": "Optional external Ponytail arm. Disabled unless exact upstream version, licence notice, integration method, and prompt/source provenance are recorded.",
      "enabled": false,
      "external_source": {
        "commit": "2ed6c52c9d7e5e56942508591085fd45dea277d3",
        "license": "MIT",
        "repository": "DietrichGebert/ponytail"
      },
      "id": "ponytail-experimental"
    }
  ],
  "author": "Dr.-Ing. Babak Sorkhpour, with AI assistance",
  "design": {
    "cross_arm_context_reuse": false,
    "failed_and_timed_out_runs_included": true,
    "fresh_workspace_per_run": true,
    "intention_to_treat": true,
    "order": "deterministic balanced Latin rotation derived from protocol seed",
    "provider_and_model_requested_served_both_required": true,
    "repetitions_per_enabled_arm": 5,
    "seed": 680001,
    "timeout_seconds": 1800,
    "unit_of_randomisation": "task-provider-repetition"
  },
  "hard_gates": [
    "acceptance_criteria_complete",
    "post_change_tests_passed",
    "security_privacy_controls_passed",
    "independent_review_passed",
    "source_change_bound_to_post_tree",
    "no_secret_or_private_data_disclosure",
    "no_unapproved_runtime_dependency",
    "rollback_or_no_change_rationale_verified"
  ],
  "primary_endpoints": [
    {
      "direction": "non-inferior",
      "id": "hard_gate_pass_rate",
      "minimum": "100% for publishable successful runs"
    },
    {
      "conditional_on": "all hard gates pass",
      "direction": "lower",
      "id": "source_lines_added"
    },
    {
      "conditional_on": "all hard gates pass",
      "direction": "lower",
      "id": "new_runtime_dependencies"
    }
  ],
  "privacy": {
    "absolute_paths_forbidden_in_public_results": true,
    "credentials_forbidden_in_receipts": true,
    "customer_data_forbidden": true,
    "public_fixture_only": true,
    "raw_prompts_private_by_default": true
  },
  "production_claim": false,
  "providers": [
    {
      "id": "openai-codex",
      "qualification": "planned",
      "surface": "Codex CLI"
    },
    {
      "id": "anthropic-claude-code",
      "qualification": "planned",
      "surface": "Claude Code"
    },
    {
      "id": "google-gemini-cli",
